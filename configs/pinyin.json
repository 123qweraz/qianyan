    "profile_keys": [
      {
        "key": "c",
        "profile": "chinese"
      },
      {
        "key": "e",
        "profile": "english"
      },
      {
        "key": "j",
        "profile": "japanese"
      },
      {
        "key": "b",
        "profile": "stroke"
      },
      {
        "key": "m",
        "profile": "chinese,english,japanese"
      },
      {
        "key": "s",
        "profile": "shengpizi"
      }
    ],
    "rare_char_mode": "common_only",
    "segmentation_delimiters": "'",
    "swap_arrow_keys": false
